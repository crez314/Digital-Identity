# ── crez-api ──────────────────────────────────────────────
NODE_ENV=development
API_PORT=3001
DATABASE_URL=postgresql://crez:crez@localhost:5432/crez?schema=public
REDIS_URL=redis://localhost:6379

# ── Object storage (S3 compatible) ────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=crez-media
S3_ACCESS_KEY=crezadmin
S3_SECRET_KEY=crezadmin
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_TTL_SECONDS=900

# ── crez-ml ───────────────────────────────────────────────
ML_BASE_URL=http://localhost:8000
ML_INTERNAL_TOKEN=dev-internal-token
ML_MODE=cpu           # cpu | gpu | mock

# ── Auth (OIDC) ───────────────────────────────────────────
# 필수. 없거나 틀린 값이면 api가 기동하지 않는다. dev는 NODE_ENV=production에서 거부된다(§16).
# oidc 모드는 OIDC_ISSUER와 OIDC_AUDIENCE가 모두 필요하다.
AUTH_MODE=dev         # dev | oidc
OIDC_ISSUER=
OIDC_AUDIENCE=
JWT_SECRET=dev-only-secret-change-me

# ── Encryption ────────────────────────────────────────────
# identity.legal_name 컬럼 암호화
FIELD_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# 얼굴·신체 임베딩(생체인식정보) 암호화. FIELD_ENCRYPTION_KEY와 다른 키여야 한다(§16, ADR 0003).
# 아래는 개발 전용 예시 값이며 NODE_ENV=production에서는 거부된다. 새 키 발급: openssl rand -hex 32
# 키를 잃으면 저장된 임베딩을 읽을 수 없다 — 원본 사진이 있으면 사진 재검사와 프로파일 재빌드로 다시 만든다.
BIOMETRIC_ENCRYPTION_KEY=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210

# ── Generation providers ──────────────────────────────────
GEN_MOCK_ENABLED=true
GEN_EXTERNAL_API_KEY=
GEN_EXTERNAL_BASE_URL=

# Higgsfield (https://api.higgsfield.ai) — 콘솔에서 발급한 API 키
# 인증 헤더는 `Authorization: Key {ID}:{SECRET}` 형식이다 (Bearer 아님).
# 값이 없으면 higgsfield-* 모델은 제출 시 실패한다 — mock으로 조용히 대체되지 않는다.
HIGGSFIELD_KEY_ID=
HIGGSFIELD_KEY_SECRET=
HIGGSFIELD_BASE_URL=https://api.higgsfield.ai

# ── Observability ─────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=debug
