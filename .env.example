# ── crez-api ──────────────────────────────────────────────
NODE_ENV=development
API_PORT=3001
DATABASE_URL=postgresql://crez:crez@localhost:5432/crez?schema=public
REDIS_URL=redis://localhost:6379

# ── Object storage (S3 compatible) ────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=crez-media
S3_ACCESS_KEY=crezadmin
S3_SECRET_KEY=crezadmin
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_TTL_SECONDS=900

# ── crez-ml ───────────────────────────────────────────────
ML_BASE_URL=http://localhost:8000
ML_INTERNAL_TOKEN=dev-internal-token
ML_MODE=cpu           # cpu | gpu | mock

# ── Auth (OIDC) ───────────────────────────────────────────
AUTH_MODE=dev         # dev | oidc
OIDC_ISSUER=
OIDC_AUDIENCE=
JWT_SECRET=dev-only-secret-change-me

# ── Encryption (identity.legal_name 컬럼 암호화) ──────────
FIELD_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ── Generation providers ──────────────────────────────────
GEN_MOCK_ENABLED=true
GEN_EXTERNAL_API_KEY=
GEN_EXTERNAL_BASE_URL=

# ── Observability ─────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=debug
